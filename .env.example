# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high

# --- Hunter.io (https://hunter.io/api-keys) ---
HUNTER_API_KEY=

# --- Gmail ---
# OAuth "Desktop app" client downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
SENDER_NAME=
SENDER_EMAIL=
# Required by CAN-SPAM in every commercial email
PHYSICAL_ADDRESS=

# --- Sending limits (protect your domain reputation) ---
DAILY_EMAIL_CAP=30
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=180
FOLLOWUP_AFTER_DAYS=4
MAX_FOLLOWUPS=2

# --- Instagram Graph API (professional account linked to a Facebook Page) ---
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_PAGE_ID=
# GRAPH_API_VERSION=v23.0

# --- Daily run (AWS Lambda, 08:00 IST) ---
# Who gets the daily digest and failure alerts (defaults to SENDER_EMAIL)
DIGEST_EMAIL=
ALERT_EMAIL=
DAILY_DRAFT_LIMIT=20
DAILY_DISCOVERY_LIMIT=10

# --- Storage ---
# After `scripts/deploy.sh`, set this to the DatabaseUri output so the CLI and Lambda share one database
AGENT_DB_S3_URI=
# AGENT_DATA_DIR=data
# BRAND_FILE=brand.md
