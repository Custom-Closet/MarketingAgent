# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# --- Or run the model on Amazon Bedrock instead of the Claude API ---
# LLM_PROVIDER=bedrock                       # auto-selected when BEDROCK_MODEL_ID is set and ANTHROPIC_API_KEY isn't
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5 # any Bedrock model; non-Claude models (e.g. openai.gpt-5.5) use the Converse API
# BEDROCK_REGION=ap-south-1                  # defaults to AWS_REGION
# AWS_BEARER_TOKEN_BEDROCK=                  # Bedrock API key (preferred over AWS access keys)
# ANTHROPIC_EFFORT=medium          # low | medium | high

# --- Hunter.io (https://hunter.io/api-keys) ---
HUNTER_API_KEY=

# --- Gmail ---
# OAuth "Desktop app" client downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
SENDER_NAME=
SENDER_EMAIL=
# Required by CAN-SPAM in every commercial email
PHYSICAL_ADDRESS=

# --- Sending limits (protect your domain reputation) ---
DAILY_EMAIL_CAP=30
MIN_DELAY_SECONDS=45
MAX_DELAY_SECONDS=180
FOLLOWUP_AFTER_DAYS=4
MAX_FOLLOWUPS=2

# --- Instagram Graph API (professional account linked to a Facebook Page) ---
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_PAGE_ID=
# GRAPH_API_VERSION=v23.0

# --- Prospecting (Marketing › Prospecting in `agent serve`, or `agent brands run`) ---
# Web search for keyword / city sweeps - the biggest source of candidates. Set one of the two.
BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# BRAND_LEADS_PER_REGION=20
# BRAND_SEARCH_QUERIES=100         # web searches per run
# BRAND_LOOKUP_LIMIT=300           # Business Discovery lookups per run
# BRAND_HASHTAG_BUDGET=0           # hashtag sweep off: the API returns captions without @mentions (max 30 / 7 days)
# BRAND_LEADS_TO_PIPELINE=1        # add delivered brands as leads so DMs get drafted for review

# --- Daily run (AWS Lambda, 08:00 IST) ---
# Who gets the daily digest and failure alerts (defaults to SENDER_EMAIL)
DIGEST_EMAIL=
ALERT_EMAIL=
DAILY_DRAFT_LIMIT=20
DAILY_DISCOVERY_LIMIT=10

# --- Storage ---
# After `scripts/deploy.sh`, set this to the DatabaseUri output so the CLI and Lambda share one database
AGENT_DB_S3_URI=
# AGENT_DATA_DIR=data
# BRAND_FILE=brand.md
